---
// Shared navigation: logo, availability pill, blog link, theme toggle, contact
---

<header class="shell flex justify-between items-center gap-4 py-5">
  <a href="/" aria-label="radibit home" class="flex items-center no-underline shrink-0">
    <svg
      viewBox="0 0 427 426"
      xmlns="http://www.w3.org/2000/svg"
      fill-rule="evenodd"
      clip-rule="evenodd"
      stroke-linejoin="round"
      stroke-miterlimit="2"
      width="44"
      height="44"
      aria-hidden="true"
    >
      <path
        d="M.964 122.489v-.563L123.705.364v122.125V.364h302.532v303.147h-.3L303.496 425.636H.964V122.489z"
        class="fill-fg"
      />
      <g font-family="'Futura-Medium','Futura',sans-serif" font-weight="500" font-size="110.64">
        <text x="71.6" y="250.816" class="fill-bg">
          r<tspan x="112.225px 178.566px" y="250.816px 250.816px">adi</tspan>
        </text>
        <text x="151.419" y="375.287" class="fill-accent">bit</text>
      </g>
    </svg>
  </a>

  <p
    class="label-mono hidden desk:inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2 text-muted"
  >
    <span aria-hidden="true" class="block size-2 rounded-full bg-accent"></span>
    Available for consultancy &amp; workshops
  </p>

  <nav aria-label="Main" class="flex items-center gap-1 sm:gap-2">
    <a
      href="/#experience"
      class="label-mono hidden md:inline-block rounded-full px-4 py-[0.6rem] text-fg no-underline transition-colors duration-200 hover:bg-surface"
    >
      Experience
    </a>
    <a
      href="/#projects"
      class="label-mono hidden md:inline-block rounded-full px-4 py-[0.6rem] text-fg no-underline transition-colors duration-200 hover:bg-surface"
    >
      Projects
    </a>
    <a
      href="/posts"
      class="label-mono rounded-full px-4 py-[0.6rem] text-fg no-underline transition-colors duration-200 hover:bg-surface"
    >
      Writing
    </a>

    <button
      id="theme-toggle"
      aria-label="Switch colour theme"
      class="label-mono flex items-center gap-2 rounded-full border border-line bg-transparent text-fg px-4 py-[0.55rem] cursor-pointer transition-colors duration-200 hover:bg-surface"
    >
      <span aria-hidden="true" class="text-[0.9rem] leading-none">◐</span>
      <span id="theme-label" class="hidden sm:inline">System mode</span>
    </button>

    <a
      href="mailto:contact@radibit.com"
      class="label-mono hidden sm:inline-block rounded-full bg-fg text-bg px-4 py-[0.6rem] no-underline transition-opacity duration-200 hover:opacity-80"
    >
      Get in touch
    </a>
  </nav>
</header>

<script>
  const MODES = ['system', 'light', 'dark'] as const;
  type Mode = (typeof MODES)[number];

  const toggle = document.getElementById('theme-toggle');
  const label = document.getElementById('theme-label');
  const html = document.documentElement;

  const modeLabels: Record<Mode, string> = {
    system: 'System mode',
    light: 'Light mode',
    dark: 'Dark mode',
  };

  function getStoredMode(): Mode {
    const saved = localStorage.getItem('theme');
    if (saved === 'light' || saved === 'dark') return saved;
    return 'system';
  }

  function applyMode(mode: Mode) {
    if (mode === 'system') {
      localStorage.removeItem('theme');
      const sys = window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light';
      html.setAttribute('data-theme', sys);
    } else {
      localStorage.setItem('theme', mode);
      html.setAttribute('data-theme', mode);
    }
    if (label) label.textContent = modeLabels[mode];
    toggle?.setAttribute('aria-label', `Switch colour theme, current: ${modeLabels[mode]}`);
  }

  let currentMode: Mode = getStoredMode();
  // Set label on init; theme is already applied by the no-flash inline script
  if (label) label.textContent = modeLabels[currentMode];
  toggle?.setAttribute('aria-label', `Switch colour theme, current: ${modeLabels[currentMode]}`);

  toggle?.addEventListener('click', () => {
    const idx = MODES.indexOf(currentMode);
    currentMode = MODES[(idx + 1) % MODES.length];
    applyMode(currentMode);
  });
</script>
