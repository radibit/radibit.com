---
import type { MarkdownLayoutProps } from 'astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import Layout from './Layout.astro';

type Props = MarkdownLayoutProps<{
  title: string;
  external_url?: string;
}>;

const { frontmatter } = Astro.props;
const { title, external_url } = frontmatter;
---

<Layout title={`${title} · radibit`} type="article">
  <SiteNav />

  <main class="shell pt-12 pb-24 md:pt-20">
    <article class="max-w-[72ch] mx-auto">
      <a
        href="/posts"
        class="label-mono inline-block text-muted no-underline mb-10 hover:text-fg"
      >
        <span aria-hidden="true">←</span> All writing
      </a>

      {external_url ? (
        <div>
          <h1 class="font-display font-light text-[clamp(2.25rem,5.5vw,3.75rem)] leading-[1.05] tracking-[-0.035em] mb-10">
            {title}
          </h1>

          <div class="rounded-card bg-surface p-8 md:p-10">
            <p class="label-mono inline-flex items-center gap-2 rounded-full bg-bg border border-line px-3 py-[0.4rem] text-muted mb-6">
              <span aria-hidden="true" class="block size-[0.4rem] rounded-full bg-accent"></span>
              External article
            </p>
            <p class="text-base leading-[1.65] text-muted mb-8 max-w-[48ch]">
              This post was published externally. Follow the link below to read the full article.
            </p>
            <a
              href={external_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block rounded-full bg-fg text-bg px-6 py-3 text-[0.9375rem] font-medium no-underline transition-opacity duration-200 hover:opacity-80"
            >
              Read on external site <span aria-hidden="true">↗</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
      ) : (
        <div>
          <h1 class="font-display font-light text-[clamp(2.25rem,5.5vw,3.75rem)] leading-[1.05] tracking-[-0.035em] mb-12 pb-10 border-b border-line">
            {title}
          </h1>

          <div class="prose">
            <slot />
          </div>
        </div>
      )}
    </article>
  </main>

  <SiteFooter />
</Layout>
