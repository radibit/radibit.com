---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteNav from '../../components/SiteNav.astro';
import Layout from '../../layouts/Layout.astro';
import { getPosts } from '../../lib/posts';

const posts = getPosts();
---

<Layout title="Writing · radibit" description="Articles and talks by Radimir Bitsov on web and mobile accessibility, performance, and sustainable engineering.">
  <SiteNav />

  <main class="shell pt-12 pb-24 md:pt-20">
    <div class="max-w-240">
      <p class="label-mono text-muted mb-6">Writing &amp; talks <span aria-hidden="true">/</span> {posts.length} entries</p>
      <h1 class="font-display font-light text-[clamp(3rem,8vw,6rem)] leading-[0.98] tracking-[-0.04em] mb-16">
        Writing
      </h1>

      <ul class="list-none">
        {posts.map((post) => (
          <li class="border-t border-line last:border-b">
            <a
              href={post.external_url ?? post.url}
              target={post.external_url ? '_blank' : undefined}
              rel={post.external_url ? 'noopener noreferrer' : undefined}
              class="group grid grid-cols-1 gap-2 py-8 no-underline text-fg sm:grid-cols-[8rem_1fr_auto] sm:gap-8 sm:items-baseline"
            >
              {post.formattedDate && (
                <time datetime={post.dateStr} class="label-mono text-muted">
                  {post.formattedDate}
                </time>
              )}
              <span class="font-display font-light text-[clamp(1.375rem,3vw,1.875rem)] tracking-[-0.025em] leading-[1.2] transition-colors duration-200 group-hover:text-accent-ink">
                {post.title}
              </span>
              <span aria-hidden="true" class="label-mono text-muted">
                {post.external_url ? 'External ↗' : 'Read →'}
              </span>
              {post.external_url && <span class="sr-only"> (external, opens in a new tab)</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>

  <SiteFooter />
</Layout>
